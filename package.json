{
  "name": "protolens-ai",
  "version": "1.0.0",
  "description": "ProtoLens AI - Multi-Agent Software Review Platform",
  "private": true,
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install && cd client && npm install",
    "build-client": "cd client && npm run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "uuid": "^10.0.0"
  }
}
